# Example nginx server for a static deploy of dist/.
# Point root at the built directory. Replace server_name with your host
# (tillhome.de is one live example of this project).

server {
    listen 80;
    listen [::]:80;
    server_name home.example.com;

    root /var/www/portal;
    index index.html;

    location / {
        try_files $uri $uri/ =404;
    }

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
}
