# Example Caddy config for a static deploy of dist/.
# Copy the built folder to the root path, then include or adapt this file.
#
# Live example: tillhome.de serves this project from /var/www/tillhome.

:80 {
	root * /var/www/portal
	encode gzip
	file_server
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
}
